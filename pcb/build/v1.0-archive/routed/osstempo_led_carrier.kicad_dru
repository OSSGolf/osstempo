(version 1)

# Generated by kicad-agent from board manifest and component-knowledge physical constraints.
# KiCad treats netclass track/via values as defaults; these rules make source constraints DRC-enforced.

# source: net_class:Default
(rule "agent_default_copper_geometry"
    (condition "A.NetName != '5V' && A.NetName != 'GND' && A.NetName != 'ESP32_IO5' && A.NetName != 'DIN'")
    (constraint clearance (min 0.2mm))
    (constraint track_width (min 0.25mm) (opt 0.25mm))
)

# source: net_class:Default
(rule "agent_default_via_geometry"
    (condition "A.Type == 'Via' && (A.NetName != '5V' && A.NetName != 'GND' && A.NetName != 'ESP32_IO5' && A.NetName != 'DIN')")
    (constraint via_diameter (min 0.6mm))
    (constraint hole_size (min 0.3mm))
)

# source: net_class:Power
(rule "agent_power_copper_geometry"
    (condition "A.NetName == '5V' || A.NetName == 'GND'")
    (constraint clearance (min 0.25mm))
    (constraint track_width (min 0.5mm) (opt 1mm))
)

# source: net_class:Power
(rule "agent_power_via_geometry"
    (condition "A.Type == 'Via' && (A.NetName == '5V' || A.NetName == 'GND')")
    (constraint via_diameter (min 0.6mm))
    (constraint hole_size (min 0.3mm))
)

# source: net_class:Data
(rule "agent_data_copper_geometry"
    (condition "A.NetName == 'ESP32_IO5' || A.NetName == 'DIN'")
    (constraint clearance (min 0.2mm))
    (constraint track_width (min 0.3mm) (opt 0.3mm))
)

# source: net_class:Data
(rule "agent_data_via_geometry"
    (condition "A.Type == 'Via' && (A.NetName == 'ESP32_IO5' || A.NetName == 'DIN')")
    (constraint via_diameter (min 0.6mm))
    (constraint hole_size (min 0.3mm))
)

# source: netclass_matrix:Default:Power
(rule "agent_default_to_power_clearance"
    (condition "((A.NetName != '5V' && A.NetName != 'GND' && A.NetName != 'ESP32_IO5' && A.NetName != 'DIN') && (B.NetName == '5V' || B.NetName == 'GND')) || ((A.NetName == '5V' || A.NetName == 'GND') && (B.NetName != '5V' && B.NetName != 'GND' && B.NetName != 'ESP32_IO5' && B.NetName != 'DIN'))")
    (constraint clearance (min 0.25mm))
)

# source: netclass_matrix:Default:Data
(rule "agent_default_to_data_clearance"
    (condition "((A.NetName != '5V' && A.NetName != 'GND' && A.NetName != 'ESP32_IO5' && A.NetName != 'DIN') && (B.NetName == 'ESP32_IO5' || B.NetName == 'DIN')) || ((A.NetName == 'ESP32_IO5' || A.NetName == 'DIN') && (B.NetName != '5V' && B.NetName != 'GND' && B.NetName != 'ESP32_IO5' && B.NetName != 'DIN'))")
    (constraint clearance (min 0.2mm))
)

# source: netclass_matrix:Power:Data
(rule "agent_power_to_data_clearance"
    (condition "((A.NetName == '5V' || A.NetName == 'GND') && (B.NetName == 'ESP32_IO5' || B.NetName == 'DIN')) || ((A.NetName == 'ESP32_IO5' || A.NetName == 'DIN') && (B.NetName == '5V' || B.NetName == 'GND'))")
    (constraint clearance (min 0.25mm))
)
